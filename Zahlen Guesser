Random r = new Random();

Console.Write("Von welcher Zahl soll geraten werden? ");
int min = Convert.ToInt32(Console.ReadLine());

Console.Write("Bis zu welcher Zahl soll geraten werden? ");
int max = Convert.ToInt32(Console.ReadLine());

int zahl = r.Next(min, max + 1);
int tipp = 0;

Console.WriteLine("Rate eine Zahl von " + min + " bis " + max + ".");

while (tipp != zahl)
{
    Console.Write("Tipp: ");
    tipp = Convert.ToInt32(Console.ReadLine());

    if (tipp < zahl)
    {
        Console.WriteLine("Zu klein!");
    }
    else if (tipp > zahl)
    {
        Console.WriteLine("Zu gross!");
    }
    else
    {
        Console.WriteLine("Richtig!");
    }
}
